# ==============================================================================
# Hyper Technology Store - Environment Variables Configuration (Vercel & Local)
#
# Production Deployment Guidelines (Vercel 2026):
# 1. In Vercel Project Dashboard -> Settings -> Environment Variables:
#    Add: DATABASE_URL, JWT_SECRET, JWT_REFRESH_SECRET, NODE_ENV=production
# 2. If deploying Frontend and Backend as separate Vercel projects:
#    Frontend Project: VITE_API_BASE_URL=https://your-backend-api.vercel.app
#    Backend Project: CLIENT_URL=https://your-frontend.vercel.app
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Neon PostgreSQL Serverless Connection (SSL Mode Required)
# Example: postgresql://neondb_owner:password@ep-cool-frost-12345.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Authentication & Security Secrets (Generate secure random 64-char strings for production)
JWT_SECRET=nlp_superapp_secure_production_secret_key_2026_jwt_hash
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=nlp_superapp_secure_refresh_secret_key_2026_jwt_refresh
JWT_REFRESH_EXPIRES_IN=30d

# Daily USD/EGP Currency Exchange Rate Provider
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/USD
EXCHANGE_RATE_API_KEY=

# Store & Payment Instructions (Supervisor: Eng. Ahmed El-Sayed - باش مهندس أحمد السيد)
INSTAPAY_PUBLIC_INFO=01017719898@instapay
VODAFONE_CASH_PUBLIC_INFO=01017719898

# Frontend Client Environment Variables (Vite - prefixed with VITE_)
# Optional for Monorepo (defaults to /api/v1). Set if client is hosted separately.
VITE_API_BASE_URL=
